# Khoj Marketplace Frontend Environment Variables (Vercel)

# Backend API URL (Points to your deployed Express backend on Vercel)
# Example: https://khoj-backend.vercel.app/api
NEXT_PUBLIC_API_URL=https://your-backend-domain.vercel.app/api

# Frontend Public App URL
# Example: https://khoj.vercel.app
NEXT_PUBLIC_APP_URL=https://your-frontend-domain.vercel.app

# Better Auth Configuration
BETTER_AUTH_SECRET=your_better_auth_secret_key_generate_one_with_openssl
BETTER_AUTH_URL=https://your-frontend-domain.vercel.app

# MongoDB Connection String for Better-Auth
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/Khoj?retryWrites=true&w=majority

# ImgBB API Configuration for Image Uploads
NEXT_PUBLIC_IMGBB_API_KEY=your_imgbb_api_key
IMGBB_API_KEY=your_imgbb_api_key

# Google OAuth Credentials (Optional / if Google login is used)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
