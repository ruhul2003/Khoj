# Khoj Marketplace Backend Environment Variables
PORT=5000
NODE_ENV=production

# MongoDB Atlas Connection URI (Must allow 0.0.0.0/0 in MongoDB Atlas Network Access for Vercel)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/Khoj?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=your_jwt_secret_key_here

# ImgBB API Key for Image Uploads
IMGBB_API_KEY=your_imgbb_api_key

# Google OAuth Credentials (optional for backend JWT sync)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
